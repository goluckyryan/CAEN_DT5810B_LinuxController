# Python bytecode -- regenerated on every run
__pycache__/
*.py[cod]

# Virtualenvs
.venv/
venv/

# Editor and OS droppings
*~
*.swp
.DS_Store

# Source snapshot taken before the register-address fix (2026-09-24). Git
# history replaces it now, and REGISTER_ADDRESS_BUG.md documents the change
# itself. Left on disk, deliberately not tracked -- a tarball is opaque to diff.
backup_pre_addrfix/

# Lab scratch work: the 26 numbered experiments, the superseded deliverables and
# the AWG pair. They are the evidence README.md rests on and are kept on disk,
# but they are not part of the shipped software and change constantly. INDEX.md
# is the exception -- it records which experiment proved what and which were
# confounded, so it stays tracked and README.md can keep pointing at it.
experiments/*
!experiments/INDEX.md

# Scope/USB captures produced by running the experiments. The vendor reference
# traces in reference/*.json ARE tracked: they are measured ground truth that
# the shape work in README.md section 9b is checked against, not build output.
*.pcap
scope_capture_*.json
